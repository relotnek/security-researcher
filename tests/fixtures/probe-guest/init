#!/bin/busybox sh
# Probe guest: reports reachability from inside the VM on the serial console.
/bin/busybox --install -s /bin
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
for m in $(cat /mods/order); do insmod "/mods/$m" || echo "insmod $m failed"; done

IP= PROXY= ALLOWED= BLOCKED= MARK= NETPROBE=1
for w in $(cat /proc/cmdline); do
    case "$w" in
        asr.ip=*) IP=${w#*=} ;;
        asr.proxy=*) PROXY=${w#*=} ;;
        asr.allowed=*) ALLOWED=${w#*=} ;;
        asr.blocked=*) BLOCKED=${w#*=} ;;
        asr.mark=*) MARK=${w#*=} ;;
        asr.netprobe=*) NETPROBE=${w#*=} ;;
    esac
done

ip link set lo up
ip link set eth0 up
ip addr add "$IP" dev eth0
echo "ASR_BOOT_OK ip=$IP mac=$(cat /sys/class/net/eth0/address)"

# Persistent state: report what a previous boot left on disk, then leave a mark.
if [ -b /dev/vda ]; then
    PREV=$(dd if=/dev/vda bs=64 count=1 2>/dev/null | tr -d '\000')
    echo "ASR_DISK_PREV=[$PREV]"
    if [ -n "$MARK" ]; then
        printf '%s' "$MARK" | dd of=/dev/vda bs=64 count=1 conv=sync 2>/dev/null
        sync
        echo "ASR_DISK_WROTE=[$MARK]"
    fi
fi

via_proxy() { http_proxy="http://$PROXY" wget -q -T 5 -O- "$1" 2>/dev/null; }
direct() { wget -Y off -q -T 5 -O- "$1" 2>/dev/null; }

if [ "$NETPROBE" = 1 ]; then
    # The allowlisted host may come up after we boot: wait for it.
    n=0
    until OUT=$(via_proxy "http://$ALLOWED/"); do
        n=$((n + 1)); [ "$n" -ge 60 ] && break; sleep 2
    done
    echo "ASR_ALLOWED=[$OUT]"
    OUT=$(via_proxy "http://$BLOCKED/") && echo "ASR_BLOCKED=REACHED[$OUT]" || echo "ASR_BLOCKED=DENIED"

    # The allowlisted host tells us which outside addresses to try directly.
    TARGETS=$(via_proxy "http://$ALLOWED/direct.txt")
    echo "ASR_ROUTES_BEFORE=[$(ip route | tr '\n' ';')]"
    for t in $TARGETS; do
        OUT=$(direct "http://$t/") && echo "ASR_DIRECT_$t=REACHED[$OUT]" || echo "ASR_DIRECT_$t=BLOCKED"
    done
    # Adversarial: point a default route at the only other host on the segment.
    ip route add default via "${PROXY%:*}" && echo "ASR_DEFAULT_ROUTE_ADDED"
    for t in $TARGETS; do
        OUT=$(direct "http://$t/") && echo "ASR_ROUTED_$t=REACHED[$OUT]" || echo "ASR_ROUTED_$t=BLOCKED"
    done
fi
echo "ASR_PROBE_DONE"
while true; do sleep 3600; done
